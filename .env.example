# Copy to .env.local and fill in. See SUPABASE_SETUP.md for the Supabase
# steps. Nothing here is required to run `npm run dev` — every integration
# degrades gracefully (auth disabled, Stripe/AI hints mocked) when its keys
# are missing. Payment routes return 503 without STRIPE_SECRET_KEY; configure
# Stripe before accepting paid customers (see src/lib/stripe.ts).

# ── Supabase (auth + progress sync + subscriptions) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — Settings → API in the Supabase dashboard. Keep secret,
# never expose client-side. Used by server-side scorecards, account operations,
# and the Stripe webhook; the service role bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Founder-only pages (/admin/metrics). Comma-separated Supabase user ids
# (Authentication -> Users -> the user's UID), not emails: an id can't be
# claimed by signing up. Empty means nobody, and the pages 404 for everyone.
FOUNDER_USER_IDS=

# ── Stripe ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_SCHOOL_PRICE_ID=

# ── Site URL override ─────────────────────────────────────────────────────
# Optional for Stripe redirect URLs. Production defaults to the canonical
# https://strikelab.dev; preview deployments use their own Vercel URL.
# Canonical metadata/sitemap are fixed in src/lib/site.ts and do not read
# NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_BASE_URL=

# ── Optional integrations ────────────────────────────────────────────────
# AI hints (src/app/api/ai/hint) — falls back to canned hints if unset.
GROQ_API_KEY=
# Newsletter signup form (src/components/NewsletterSignup.tsx).
NEXT_PUBLIC_WEB3FORMS_KEY=
# Error monitoring — create a free project at sentry.io, safe to expose.
NEXT_PUBLIC_SENTRY_DSN=
# Ops alerts (src/lib/opsAlert.ts) — a Discord webhook URL for a private
# channel only you read, separate from users' own webhooks. Server-only,
# never expose client-side. Unset = no-op.
OPS_DISCORD_WEBHOOK_URL=

# Seasons: secret for each student's own challenge numbers (any long random
# string; changing it changes everyone's numbers, so set it once). Server-only.
SEASON_PARAM_SECRET=
