# Copy to .env.local and fill in. See SUPABASE_SETUP.md for the Supabase
# steps. Nothing here is required to run `npm run dev` — every integration
# degrades gracefully (auth disabled, Stripe/AI hints mocked) when its keys
# are missing, except in a production deploy, where STRIPE_SECRET_KEY is
# required (see src/lib/stripe.ts).

# ── Supabase (auth + progress sync + subscriptions) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — Settings → API in the Supabase dashboard. Keep secret,
# never expose client-side. Used only by the Stripe webhook to write
# subscription state (bypasses Row Level Security by design).
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_SCHOOL_PRICE_ID=

# ── Site URLs ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://strikelabco.vercel.app
NEXT_PUBLIC_BASE_URL=https://strikelabco.vercel.app

# ── Optional integrations ────────────────────────────────────────────────
# AI hints (src/app/api/ai/hint) — falls back to canned hints if unset.
GROQ_API_KEY=
# Newsletter signup form (src/components/NewsletterSignup.tsx).
NEXT_PUBLIC_WEB3FORMS_KEY=
# Error monitoring — create a free project at sentry.io, safe to expose.
NEXT_PUBLIC_SENTRY_DSN=
